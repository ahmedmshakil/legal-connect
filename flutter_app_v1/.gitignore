# ================================
# Flutter App .gitignore
# ================================

# ---------- OS / Editor ----------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
*.iml
*.ipr
*.iws
.atom/
.history

# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example
*.pem
*.pk
*.p12
*.jks
*.keystore
key.properties
google-services.json
GoogleService-Info.plist
**/credentials.json
**/service-account*.json

# ---------- Flutter / Dart ----------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
devtools_options.yaml
.pub-cache/
.pub/
/build/
/coverage/
**/doc/api/
**/ios/Flutter/.last_build_id
pubspec.lock

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Generated files
*.g.dart
*.freezed.dart

# ---------- Android ----------
/android/.gradle/
/android/captures/
/android/gradlew
/android/gradlew.bat
/android/local.properties
/android/app/debug/
/android/app/profile/
/android/app/release/
.cxx/
GeneratedPluginRegistrant.java

# ---------- iOS ----------
**/Pods/
**/xcuserdata/
**/.symlinks/
**/DerivedData/
**/*.moved-aside
**/*.pbxuser
!default.pbxuser
**/*.perspectivev3
!default.perspectivev3
**/*.mode1v3
!default.mode1v3
**/*.mode2v3
!default.mode2v3
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Flutter/app.flx
ios/Flutter/app.zip
ios/Flutter/flutter_assets/
ios/Flutter/flutter_export_environment.sh
ios/ServiceDefinitions.json
ios/Runner/GeneratedPluginRegistrant.*

# ---------- Misc ----------
*.class
*.log
*.pyc
*.tmp
*.bak
*.orig
.build/
.buildlog/
.svn/
.swiftpm/
migrate_working_dir/
